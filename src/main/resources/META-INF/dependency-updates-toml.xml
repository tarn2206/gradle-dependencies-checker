<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="TOML"
                         displayName="Outdated Gradle dependency"
                         groupName="Gradle"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.tarn2206.editor.OutdatedDependencyTomlInspection"/>
        <localInspection language="TOML"
                         displayName="Vulnerable Gradle dependency"
                         groupName="Gradle"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.tarn2206.editor.VulnerableDependencyTomlInspection"/>
        <codeInsight.lineMarkerProvider language="TOML"
                                        implementationClass="com.github.tarn2206.editor.DependencyLineMarkerProvider"/>
    </extensions>
</idea-plugin>