<idea-plugin>
    <id>tarn.gradle.dependencies</id>
    <name>Gradle Dependency Updates</name>
    <vendor email="tarn.net@gmail.com" url="https://github.com/tarn2206">t@rn</vendor>

    <description><![CDATA[
        Check gradle projects dependencies for version upgrades.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends optional="true" config-file="dependency-updates-toml.xml">org.toml.lang</depends>
    <depends optional="true" config-file="dependency-updates-groovy.xml">org.intellij.groovy</depends>
    <depends optional="true" config-file="dependency-updates-kotlin.xml">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.tarn2206.AppSettings"/>
        <projectService serviceImplementation="com.github.tarn2206.tooling.DependencyStateService"/>
        <projectService serviceImplementation="com.github.tarn2206.tooling.AutoRefreshHook"/>
        <toolWindow id="Dependency Updates"
                    icon="/icons/toolWindow.svg"
                    anchor="right" doNotActivateOnStart="true"
                    factoryClass="com.github.tarn2206.ui.DependenciesToolWindowFactory"/>
        <notificationGroup id="Dependency Updates" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="CheckDependencyUpdates"
                class="com.github.tarn2206.actions.CheckForUpdates"
                text="Check Dependency Updates">
            <add-to-group group-id="AnalyzeActions"/>
        </action>
    </actions>

</idea-plugin>