<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="Groovy"
                         displayName="Outdated Gradle dependency"
                         groupName="Gradle"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.tarn2206.editor.OutdatedDependencyGroovyInspection"/>
        <localInspection language="Groovy"
                         displayName="Vulnerable Gradle dependency"
                         groupName="Gradle"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.tarn2206.editor.VulnerableDependencyGroovyInspection"/>
        <codeInsight.lineMarkerProvider language="Groovy"
                                        implementationClass="com.github.tarn2206.editor.DependencyGroovyLineMarkerProvider"/>
    </extensions>
</idea-plugin>